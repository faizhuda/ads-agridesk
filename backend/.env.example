DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=agridesk
SECRET_KEY=change-this-secret-key-in-production
DB_INIT_ON_STARTUP=true
DB_INIT_FAIL_FAST=false

# Public frontend URL used for QR codes embedded in PDFs (must be accessible from mobile devices)
# Production example: BASE_URL=https://agridesk.example.com
BASE_URL=http://localhost:8000

# CORS allowed origins — comma-separated JSON array for multiple origins.
# Production example: ALLOWED_ORIGINS=["https://your-domain.com"]
# ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage — local filesystem for development; Supabase for Vercel deployment.
STORAGE_BACKEND=local

# Production (Supabase Storage)
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=agridesk-private

# Upload directory inside the container (mounted to host disk via Docker volume)
UPLOAD_DIR=uploads
